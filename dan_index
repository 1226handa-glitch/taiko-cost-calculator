                    <div class="flex flex-col items-center justify-center mr-3 shrink-0">
                        <svg viewBox="0 0 32 32" class="w-6 h-6">
                            <path class="demon-icon" d="M6 30 L6 16 L2 4 L16 10 L30 4 L26 16 L26 30 Z" />
                            <circle cx="12" cy="18" r="2" fill="#333"/>
                            <circle cx="20" cy="18" r="2" fill="#333"/>
                        </svg>
                        <span class="text-[10px] font-bold text-gray-800 -mt-1">★9</span>
                    </div>
                    <div class="font-bold text-[15px] text-gray-900 truncate">いっそこのままで</div>
                </div>

                <!-- 3曲目 -->
                <div class="bg-white rounded-full py-2.5 px-3 flex items-center shadow-sm border border-gray-100">
