                    </div>
                    <div class="flex items-center">
                        <span class="w-6 h-6 rounded-full badge-3rd flex items-center justify-center text-[10px] mr-3">3rd</span>
                        94未満
                    </div>
                </div>

                <div class="bg-[#f2d7b6] text-[#5b4636] font-bold text-[13px] px-3 py-1.5 rounded-sm mb-1.5">不可の数</div>
                <div class="bg-white text-gray-800 text-[15px] p-3 rounded-sm mb-4 font-bold flex flex-col space-y-2.5 shadow-sm">
